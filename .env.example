# Environment Variables for Pradyumna Portfolio
# Copy this file to .env.local and populate the values as needed.

# Canonical site URL (used for Open Graph metadata, Twitter cards, and sitemap)
NEXT_PUBLIC_SITE_URL="https://parthparthu.github.io"

# Base path for subpath hosting (leave empty for custom root domains or user GitHub Pages)
NEXT_PUBLIC_BASE_PATH=""

# Client-side form submission endpoints (free tier, no serverless runtime required)
# Option 1: Formspree Form ID (https://formspree.io)
NEXT_PUBLIC_FORMSPREE_ID=""

# Option 2: Web3Forms Access Key (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=""

# Destination email address for receiving direct inquiries or mailto fallback
CONTACT_EMAIL="pradyumna05@outlook.in"
