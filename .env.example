# ==============================================================================
# PRADYUMNA DEVELOPER PORTFOLIO v2.0 - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Resend API Key for contact form mail delivery (Get one at https://resend.com)
# Optional in local development (falls back gracefully to console logs if not provided)
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where contact submissions are routed
CONTACT_EMAIL=your-email@example.com

# Public Site URL for canonical meta tags, OpenGraph images, and sitemap generation
NEXT_PUBLIC_SITE_URL=https://pradyumna.dev

# Optional GitHub Token to raise client-side API rate limits from 60 to 5,000 req/hr
# Format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=
