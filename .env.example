# Environment Variables for Pradyumna Portfolio
# Copy this file to .env.local and populate the values as needed.

# Canonical site URL (used for Open Graph metadata, Twitter cards, and sitemap)
NEXT_PUBLIC_SITE_URL="https://parthparthu.github.io/me"

# Base path for subpath hosting (leave empty for custom root domains)
NEXT_PUBLIC_BASE_PATH=""

# Resend API Key for sending contact form messages via serverless API route (optional)
# If not provided, contact inquiries fall back cleanly to mailto protocol
RESEND_API_KEY=""

# Destination email address for receiving contact inquiries
CONTACT_EMAIL="pradyumna05@outlook.in"
